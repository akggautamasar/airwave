# ---------------------------------------------------------------------------
# LiveKit media server
# ---------------------------------------------------------------------------
# Get these free at https://cloud.livekit.io (Settings -> Keys), or point them
# at your own self-hosted livekit-server.
#
# LIVEKIT_URL must be the WebSocket URL (wss:// in production, ws:// locally).
# The server derives the HTTP management URL from it automatically.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# How long an empty channel lingers before LiveKit tears it down (seconds).
LIVEKIT_EMPTY_TIMEOUT=120

# Hard cap on participants per channel.
MAX_PARTICIPANTS=100
